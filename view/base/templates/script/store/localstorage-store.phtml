<?php
declare(strict_types=1);

use Loki\Base\ViewModel\ModuleConfig;
use Loki\Base\ViewModel\SectionConfig;
use Magento\Framework\View\Element\Template;

/** @version 1.3.2 */
/** @var Template $block */
/** @var SectionConfig $sectionConfig */
/** @var ModuleConfig $moduleConfig */

$moduleConfig = $block->getModuleConfig();
if ($moduleConfig->isEnabled('MageOS_AlpineLocalStorage')) {
    return;
}

$sectionConfig = $block->getSectionConfig();
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.store('LocalStorage', {
            key: 'mage-cache-storage',
            sectionLifetime: <?= (int)$sectionConfig->getSectionDataLifeTime()
            * 60 ?>,
            data: {},
            refreshPromises: {},
            init() {
                document.addEventListener('localStorageUpdate', (event) => {
                    if (event.detail.key !== this.key) {
                        return;
                    }

                    this.data = this.parseData(event.detail.value);
                })

                this.data = this.parseData(localStorage.getItem(this.key));

                let changed = false;
                let cookieSections = MageCookies.get('section_data_ids');
                if (!cookieSections || typeof cookieSections !== 'object') {
                    cookieSections = {};
                }

                Object.entries(this.data).forEach(([key, value]) => {
                    const dataId = value && value.data_id ? parseInt(value.data_id) : 0;
                    const isSectionExpired = !dataId || dataId + this.sectionLifetime < this.getCurrentTimestamp();
                    const isCookieSectionExpired = cookieSections[key] !== undefined && parseInt(cookieSections[key]) !== dataId;

                    if (isSectionExpired || isCookieSectionExpired) {
                        delete this.data[key];
                        changed = true;
                    }
                })

                if (changed) {
                    localStorage.setItem(this.key, JSON.stringify(this.data));
                }

                document.dispatchEvent(new CustomEvent('loki:init:localstorage-store', {}));
            },
            parseData(json) {
                if (!json) {
                    return {};
                }

                try {
                    const data = JSON.parse(json);
                    return data && typeof data === 'object' && !Array.isArray(data) ? data : {};
                } catch (e) {
                    return {};
                }
            },
            getNewSectionLifetime() {
                return this.getCurrentTimestamp() + this.sectionLifetime;
            },
            getCurrentTimestamp() {
                return Math.floor(Date.now() / 1000);
            },
            save() {
                localStorage.setItem(this.key, JSON.stringify(this.data), true);
            },
            async refresh(sections, forceNewSectionTimestamp) {
                const promiseKey = sections || '__all__';
                if (this.refreshPromises[promiseKey]) {
                    return this.refreshPromises[promiseKey];
                }

                this.refreshPromises[promiseKey] = (async () => {

                    let url = new URL(BASE_URL + 'customer/section/load');
                    if (sections) {
                        url.searchParams.append('sections', sections);
                    }

                    forceNewSectionTimestamp = !!forceNewSectionTimestamp;
                    if (forceNewSectionTimestamp) {
                        url.searchParams.append('force_new_section_timestamp', 'true');
                        url.searchParams.append('_', Math.floor(Date.now() / 1000));
                    }

                    const response = await fetch(url, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                    });

                    const newData = await response.json();

                    if (typeof newData === 'object') {
                        this.data = Object.assign(Alpine.raw(this.data), newData);
                        this.save();
                    }

                    return newData;
                })();

                try {
                    return await this.refreshPromises[promiseKey];
                } finally {
                    delete this.refreshPromises[promiseKey];
                }
            },
            async get(key) {
                if (!this.data) {
                    return {};
                }

                if (key === undefined) {
                    return this.data;
                }

                if (!this.data[key]) {
                    await this.refresh(key);
                }

                return this.data[key];
            },
            set(key, value) {
                this.data[key] = value;
                this.save();
            },
            remove(key) {
                if (key !== undefined) {
                    delete this.data[key];
                    this.save();
                }
            },
            reset() {
                this.data = {};
                localStorage.removeItem(this.key);
            }
        });
    });

    const originalLocalStorageSetItem = localStorage.setItem;
    localStorage.setItem = function (key, value, skipEvent) {
        if (!skipEvent) {
            document.dispatchEvent(new CustomEvent('localStorageUpdate', {
                detail: {
                    key,
                    value
                }
            }));
        }

        originalLocalStorageSetItem.apply(this, [key, value]);
    };

    function localStorageTestMerge(additionalData) {
        if (!additionalData || Object.keys(additionalData).length === 0) {
            return;
        }

        const json = localStorage.getItem('mage-cache-storage');
        if (!json) {
            return;
        }

        const data = JSON.parse(json);
        const newData = Object.assign({}, data, additionalData);
        localStorage.setItem('mage-cache-storage', JSON.stringify(newData));
    }
</script>
