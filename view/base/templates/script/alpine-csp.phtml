<?php declare(strict_types=1);

use Loki\Base\ViewModel\ModuleConfig;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 1.3.1 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ModuleConfig $moduleConfig */

$jsUrl = $block->getViewFileUrl('Loki_Base::js/alpine-csp.min.js');
$defer = $block->hasData('defer') ? (bool)$block->getDefer() : true;
$moduleConfig = $block->getModuleConfig();

if ($moduleConfig->isEnabled('MageOS_AlpineLoader')) {
    return;
}
?>
<script src="<?= $escaper->escapeUrl($jsUrl) ?>"<?php if ($defer) : ?> defer<?php endif; ?>></script>
