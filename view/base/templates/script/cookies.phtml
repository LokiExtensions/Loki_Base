<?php
declare(strict_types=1);

use Loki\Base\ViewModel\CookieConfig;
use Loki\Base\ViewModel\ModuleConfig;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 1.3.3 */
/** @var Template $block */
/** @var CookieConfig $cookieConfig */
/** @var Escaper $escaper */
/** @var ModuleConfig $moduleConfig */

$moduleConfig = $block->getModuleConfig();
if ($moduleConfig->isEnabled('MageOS_AlpineLocalStorage')) {
    return;
}

$cookieConfig = $block->getCookieConfig();
?>
<script>
    const MageCookies = {
        lifetime: <?= (int)$cookieConfig->getLifetime() ?>,
        domain: '<?= $escaper->escapeHtml($cookieConfig->getDomain()) ?>',
        path: '<?= $escaper->escapeHtml($cookieConfig->getPath()) ?>',
        httpOnly: <?= (int)$cookieConfig->isHttpOnly() ?>,
        secure: <?= (int)$cookieConfig->isSecure() ?>,
        sameSite: '<?=  $escaper->escapeHtml($cookieConfig->getSameSite()) ?>',
        getAll() {
            const cookies = {};
            document.cookie.split(';').forEach(cookie => {
                const separatorIndex = cookie.indexOf('=');
                if (separatorIndex < 0) return;

                const name = cookie.slice(0, separatorIndex).trim();
                if (!name) return;

                let value = cookie.slice(separatorIndex + 1).trim();

                value = decodeURIComponent(value);

                if (value.startsWith('[') || value.startsWith('{')) {
                    try {
                        value = JSON.parse(value);
                    } catch (e) {
                        // Foreign non-JSON cookie (e.g. Adobe Analytics s_sq="[[B]]") — keep raw string.
                    }
                }

                cookies[name] = value;
            })

            return cookies;
        },
        get(name) {
            return this.getAll()[name];
        },
        set(name, value, lifetime) {
            if (typeof value !== 'string') {
                value = JSON.stringify(value);
            }

            let cookieParts = this.getCookieParts(name, value, lifetime);
            document.cookie = cookieParts.join('; ');
        },
        remove(name) {
            const expiredCookie = name + '=; max-age=-999999';
            const paths = this.path ? ['; path=' + this.path, ''] : [''];
            const domains = this.domain ? ['; domain=' + this.domain, ''] : [''];

            paths.forEach(path => {
                domains.forEach(domain => {
                    document.cookie = expiredCookie + path + domain;
                });
            });
        },
        getCookieParts(name, value, lifetime) {
            let cookieParts = [];

            value = encodeURIComponent(value);
            cookieParts.push(name + '=' + value);

            if (!lifetime > 0) {
                lifetime = this.lifetime;
            }
            cookieParts.push('max-age=' + lifetime);

            if (this.path) {
                cookieParts.push('path=' + this.path);
            }

            if (this.domain) {
                cookieParts.push('domain=' + this.domain);
            }

            if (this.secure || window.location.protocol === 'https:') {
                cookieParts.push('secure');
            }

            cookieParts.push('SameSite=' + this.sameSite);
            return cookieParts;
        },
        isAllowedSaving() {
            return this.get('user_allowed_save_cookie');
        }
    }
</script>
