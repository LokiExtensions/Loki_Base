<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 1.3.1 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.directive('safe-html', (el, { expression }, { evaluateLater, effect }) => {
            const evaluate = evaluateLater(expression)

            effect(() => {
                evaluate(html => {
                    const template = document.createElement('template')
                    template.innerHTML = html || ''

                    template.content.querySelectorAll('*').forEach(node => {
                        const allowed = ['STRONG', 'EM', 'BR', 'A', 'SPAN', 'P']
                        if (!allowed.includes(node.tagName)) {
                            node.replaceWith(...node.childNodes)
                            return
                        }

                        ;[...node.attributes].forEach(attr => {
                            const value = attr.value.replace(/[\s\u0000-\u001F]/g, '').toLowerCase()
                            if (
                                attr.name.startsWith('on') ||
                                (attr.name === 'href' && /^(javascript|vbscript|data):/.test(value))
                            ) {
                                node.removeAttribute(attr.name)
                            }
                        })
                    })

                    el.replaceChildren(template.content.cloneNode(true))
                })
            });
        });
    });
</script>
